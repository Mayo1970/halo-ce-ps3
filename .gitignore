# IDE folders
.idea/
.vs/

# Caches
__pycache__
.mypy_cache
.cache/

# Build files
build/
.ninja_*
build.ninja

# Generated configs
compile_commands.json

# The January build and the Xbox SDK (tools/xdk_headers.py reads the
# build's PDB); never commit
*.exe
*.pdb
xbox/
!source/**/xbox/
!port/ps3/xbox/

# Locally extracted proprietary game data (never commit)
assets/
# (but the high-res assets, drawn for the port: tools/hud_assets.py)
!port/assets/
original/

# CI build outputs (tools/ci_build.py)
dist/

# Working notes of the PS3 port (kept local)
GOALS.md
ROADMAP.md
STUTTER_FINDINGS.md
Network possibility.md
shader.md
shader_audit.md

# The public repository holds only what the PS3 build (Makefile) needs; the rest
# of the upstream tree (other platforms, tests, docs, art sources) stays local
/*
!/.gitignore
!/.gitattributes
!/.github/
!/Makefile
!/build.sh
!/README.md
!/LICENSE
!/LICENSES/
!/ICON/
!/source/
!/port/
!/tools/

# tools/ps3_msvc_semantics.py reads every .c and .h of the game, compiled or not
/source/**/*
!/source/**/
!/source/**/*.c
!/source/**/*.h
!/source/**/*.inc

/port/*
!/port/ps3/
!/port/include/
!/port/linux/
!/port/assets/
!/port/third_party/

/port/include/*
!/port/include/halo_math.h
!/port/include/xdk/

/port/linux/*
!/port/linux/port.json
!/port/linux/include/
!/port/linux/game/
!/port/linux/src/
/port/linux/game/android_ce_texture_cache.h
/port/linux/game/profile_console.h
# the Linux build's units that the Makefile's XBOX_SRCS and HOST_OBJS name, and their headers
/port/linux/src/*
!/port/linux/src/bink_null.c
!/port/linux/src/d3d8_resources.c
!/port/linux/src/halo_linker_common.c
!/port/linux/src/log_address.c
!/port/linux/src/log_address.h
!/port/linux/src/master_list.h
!/port/linux/src/msvc_crt.c
!/port/linux/src/msvc_wide.c
