/port/assets/*
!/port/assets/network/
/port/assets/network/*
!/port/assets/network/brokers.txt
!/port/assets/buttons/
/port/assets/buttons/*
!/port/assets/buttons/ps3/
!/port/assets/icon/

/port/third_party/*
!/port/third_party/kcp/
